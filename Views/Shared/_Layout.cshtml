<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stok Kontrol</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #f5efe6; color: #4a3826; }
        .container { max-width: 1100px; margin: 0 auto; padding: 24px; }
        .header { background: #d9c3a6; color: #4a3826; padding: 12px 24px; border-bottom: 1px solid #c5ad8c; }
        .brand { display: flex; align-items: center; gap: 14px; font-size: 20px; font-weight: 700; }
        .brand img { height: 42px; width: 42px; object-fit: cover; border-radius: 10px; border: 1px solid #c5ad8c; }
        .card { background: #fffaf2; border-radius: 10px; box-shadow: 0 2px 8px rgba(92,70,48,.12); padding: 20px; margin-bottom: 16px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; border-bottom: 1px solid #e8dccb; text-align: left; }
        .actions { display: flex; gap: 8px; }
        .btn { border: 0; border-radius: 6px; padding: 8px 12px; cursor: pointer; text-decoration: none; display: inline-block; font-size: 14px; }
        .btn-primary { background: #8b6f47; color: #fff; }
        .btn-secondary { background: #6f5a45; color: #fff; }
        .btn-danger { background: #b4513d; color: #fff; }
        .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
        input, select, textarea { width: 100%; box-sizing: border-box; padding: 8px; border: 1px solid #d8c8b2; border-radius: 6px; background: #fffdf8; color: #4a3826; }
        label { display: block; margin-bottom: 4px; font-weight: 600; }
        .text-danger { color: #b4513d; }
        .alert { padding: 10px; border-radius: 6px; margin-bottom: 10px; }
        .alert-danger { background: #f9ddd6; color: #7f2f20; }
        .top-nav { margin-top: 10px; display: flex; gap: 8px; align-items: center; background: #f1e5d6; padding: 10px; border-radius: 10px; box-shadow: 0 2px 8px rgba(92,70,48,.12); border: 1px solid #e0cfb8; }
        .spacer { flex: 1; }
        .search-form { display: flex; gap: 8px; width: 100%; max-width: 420px; }
        .search-form input { background: #fffaf2; }
        .product-thumb { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; border: 1px solid #e0cfb8; }
        .catalog-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
        .catalog-card { border: 1px solid #e0cfb8; border-radius: 12px; padding: 14px; background: #fffdf8; min-height: 280px; display: flex; flex-direction: column; gap: 8px; }
        .catalog-card .product-thumb { width: 100%; height: 160px; border-radius: 10px; }
        .catalog-title { margin: 0; font-size: 19px; }
        .stock-indicator { position: relative; display: inline-flex; align-items: center; justify-content: center; min-width: 52px; padding: 6px 10px; border-radius: 999px; font-weight: 700; }
        .stock-yellow { background: #f4d45a; color: #4a3826; }
        .stock-red { background: #d9534f; color: #fff; }
        .stock-black { background: #1f1f1f; color: #fff; }
        .stock-alert { position: absolute; top: -8px; right: -8px; width: 18px; height: 18px; border-radius: 999px; background: #c62828; color: #fff; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 1px 3px rgba(0,0,0,.25); }
    </style>
</head>
<body>
    <div class="header">
        <div class="brand">
            <img src="/logo-user.png" alt="Stok Kontrol Logo" onerror="this.onerror=null;this.src='/logo.svg';" />
            <span>Stok Kontrol Prototipi</span>
        </div>
    </div>
    <main class="container">
        @if ((User.Identity?.IsAuthenticated ?? false) && !(ViewData["HideNavbar"] as bool? ?? false))
        {
            <div class="top-nav">
                <a class="btn btn-secondary" asp-controller="Products" asp-action="Catalog">Katalog</a>
                @if (User.IsInRole("Admin"))
                {
                    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Admin Paneli</a>
                    <a class="btn btn-primary" asp-controller="Categories" asp-action="Index">Kategori Yonetimi</a>
                }
                <form class="search-form" asp-controller="Products" asp-action="Catalog" method="get">
                    <input type="text" name="q" value="@(ViewBag.Query ?? "")" placeholder="Urun, kod veya kategori ara..." />
                    <button class="btn btn-primary" type="submit">Ara</button>
                </form>
                <div class="spacer"></div>
                <span>@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button class="btn btn-danger" type="submit">Cikis</button>
                </form>
            </div>
            <br />
        }
        @RenderBody()
    </main>
</body>
</html>
